# AgentShield Gateway
AGENTSHIELD_API_URL=http://localhost:8000
AGENTSHIELD_API_KEY=
AGENTSHIELD_ADMIN_API_KEY=

# Groq LLM
GROQ_API_KEY=
SENDER_MODEL=openai/gpt-oss-20b
RECEIVER_MODEL=openai/gpt-oss-120b

# Supabase PostgreSQL (asyncpg)
# Pooler URL for app queries (Transaction mode, port 6543)
TICKET_DEMO_DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Direct connection URL for Alembic migrations (Session mode, port 5432)
TICKET_DEMO_DATABASE_URL_DIRECT=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].supabase.co:5432/postgres

# Email Delivery Simulation
SEND_REAL_EMAILS=false
SENDER_EMAIL=skanda.dell@gmail.com
RECEIVER_EMAIL=agentshield.demo@gmail.com

# Clock & Simulation Configuration
TICKETS_PER_DAY=12
MALICIOUS_RATE=0.45
DEMO_MODE=true
SIMULATED_DAY_SECONDS=30
